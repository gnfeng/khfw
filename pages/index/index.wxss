/* pages/index/index.wxss */
.stat-row {
  display: flex;
  margin-top: 28rpx;
  gap: 20rpx;
}
.stat {
  flex: 1;
  background: #ffffff;
  border: 1rpx solid #b0c4de;
  border-radius: 16rpx;
  text-align: center;
  padding: 26rpx 0;
  box-shadow: 0 4rpx 10rpx rgba(26, 82, 118, 0.08);
}
.stat .num {
  display: block;
  font-size: 48rpx;
  font-weight: 700;
  color: #1a5276;
  line-height: 1.2;
}
.stat .lbl {
  font-size: 24rpx;
  color: #5d6d7e;
}

.menu {
  margin-top: 28rpx;
}
.menu-item {
  display: flex;
  align-items: center;
  background: #ffffff;
  border: 1rpx solid #b0c4de;
  border-radius: 16rpx;
  padding: 26rpx 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 10rpx rgba(26, 82, 118, 0.08);
}
.mi-badge {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: #1a5276;
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}
.mi-blue { background: #2471a3; }
.mi-light { background: #5dade2; }
.mi-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1a5276;
}
.mi-text .muted {
  margin-top: 4rpx;
}
.contact {
  margin-top: 18rpx;
  text-align: center;
}
.ct-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a5276;
  margin-top: 8rpx;
}
