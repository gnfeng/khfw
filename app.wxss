/* app.wxss —— 全局样式（Ocean Gradient 校办风） */
page {
  /* 配色变量（小程序不支持 :root，这里用注释说明，组件内直接引用色值） */
  /* 主色 深海蓝 #1a5276 / #2471a3   辅色 浅蓝 #5dade2 / #aed6f1 / #d4e6f1
     强调 红 #e74c3c(警示) 绿 #27ae60(通过) 橙 #f39c12(提醒) */
  background-color: #eaf2f8;
  font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
  color: #1b2631;
  font-size: 28rpx;
  line-height: 1.7;
}

.container {
  padding: 24rpx 28rpx 48rpx;
  box-sizing: border-box;
}

/* 顶部校办标题条 */
.page-header {
  background: linear-gradient(135deg, #1a5276 0%, #2471a3 100%);
  color: #ffffff;
  padding: 36rpx 32rpx;
  border-radius: 0 0 28rpx 28rpx;
  box-shadow: 0 6rpx 18rpx rgba(26, 82, 118, 0.25);
}
.page-header .h-title {
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}
.page-header .h-sub {
  font-size: 24rpx;
  opacity: 0.85;
  margin-top: 8rpx;
}

/* 卡片 */
.card {
  background: #ffffff;
  border: 1rpx solid #b0c4de;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(26, 82, 118, 0.08);
}

/* 主按钮（深海蓝） */
.btn-primary {
  background: #2471a3;
  color: #ffffff;
  border-radius: 12rpx;
  font-size: 30rpx;
  padding: 20rpx 0;
  text-align: center;
}
.btn-primary:active { background: #1a5276; }

/* 标签 */
.tag {
  display: inline-block;
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  background: #d4e6f1;
  color: #1a5276;
  margin-right: 12rpx;
}
.tag-green { background: #d5f5e3; color: #1e8449; }
.tag-orange { background: #fdebd0; color: #ca6f1e; }
.tag-red { background: #fadbd8; color: #c0392b; }

/* 文本辅助 */
.muted { color: #5d6d7e; font-size: 24rpx; }
.divider { height: 1rpx; background: #d4e6f1; margin: 20rpx 0; }
