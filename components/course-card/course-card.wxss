/* components/course-card/course-card.wxss */
.cc-card {
  background: #ffffff;
  border: 1rpx solid #b0c4de;
  border-left: 8rpx solid #2471a3;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 22rpx;
  box-shadow: 0 4rpx 10rpx rgba(26, 82, 118, 0.08);
}
.cc-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}
.cc-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #1a5276;
}
.cc-row {
  display: flex;
  font-size: 26rpx;
  margin: 6rpx 0;
}
.cc-row .muted {
  width: 90rpx;
  color: #5d6d7e;
  flex-shrink: 0;
}
.cc-val {
  color: #1b2631;
}
.cc-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
}
